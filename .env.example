# Required
SESSION_SECRET=change-me-to-a-random-string

# Database (empty = SQLite in DATA_DIR, or set postgres://user:pass@host:5432/dbname)
# DATABASE_URL=
# DATA_DIR=./data

# Server
# LISTEN_ADDR=:8080
# PUBLIC_URL=https://dashboard.example.com
# TZ=UTC
# FRONTEND_MODE=embed
# LOG_LEVEL=info
# RETENTION_DAYS=365
# MAX_BODY_BYTES=33554432

# OIDC/OAuth2 (optional — enables "Login with SSO" button)
# OIDC_ISSUER_URL=https://auth.example.com/realms/myrealm
# OIDC_CLIENT_ID=life-dashboard
# OIDC_CLIENT_SECRET=secret
# OIDC_SCOPES=openid email profile
# OIDC_DISPLAY_NAME=Company SSO
